# Copy to .env on the EC2 host (never commit). Prefer pulling these from SSM Parameter Store.
ENVIRONMENT=production            # replaces Render's RENDER=1 for secure-cookie / prod detection
EMBEDDED_WORKER=true
API_DOMAIN=<elastic-ip-dashed>.sslip.io
DATABASE_URL=postgresql+asyncpg://telex:<password>@<rds-endpoint>:5432/telex
WEB_APP_URL=https://telex-web.vercel.app
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GEMINI_API_KEY=
LLM_PROVIDER_DEFAULT=gemini
NEXTAUTH_SECRET=
TELEX_ENCRYPTION_KEY=
WORKER_COUNT=1

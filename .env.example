# ─────────────────────────────────────────────
#  TELEX  ·  Self-Healing API Dependency Bot
# ─────────────────────────────────────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host/telex

# ── GitHub App ────────────────────────────────
# From: https://github.com/settings/apps
GITHUB_APP_ID=
# Paste the full PEM key as a single line (replace newlines with \n)
# Or point at a file: GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/telex.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth (dashboard login) ────────────
# From: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── LLM Providers ─────────────────────────────
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # Not required for V1 — add when available

# Active provider: "gemini" | "claude"
LLM_PROVIDER_DEFAULT=gemini

# ── Razorpay (Engine B — Test Mode ONLY) ──────
# From: https://dashboard.razorpay.com/app/keys (Use Test Mode keys only)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Target repository for Engine B runtime code defect escalation (e.g. "owner/repo")
# If blank, defaults to the primary active connected repository.
PAYMENT_RECOVERY_REPO_NAME=

# ── Next.js / NextAuth ────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# URL of the deployed FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000


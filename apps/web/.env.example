# ==============================================================================
# Telex Web Dashboard — Environment Variables Template (apps/web)
# Copy this file to .env.local. Never commit .env.local to git.
# ==============================================================================

# Backend API URL (use http://localhost:8000 for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub App Slug / Name
NEXT_PUBLIC_GITHUB_APP_NAME=telex-agent-dev

# GitHub OAuth App Client ID
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# NextAuth Session Secret (32+ characters)
NEXTAUTH_SECRET=telex-development-session-secret-key-32-chars-min

# Razorpay Key ID (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

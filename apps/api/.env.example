# ==============================================================================
# Telex API — Environment Variables Template (apps/api)
# Copy this file to .env or ../../.env. Never commit .env to git.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telex

# ── GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── LLM Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER_DEFAULT=gemini


# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
NEXTAUTH_SECRET=telex-development-session-secret-key-32-chars-min
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
GITHUB_APP_SLUG=telex-agent-dev
DEMO_KEY=telex_demo_secret_2026

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY=false

